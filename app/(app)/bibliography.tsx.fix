import { theme as designTheme } from '@/config/theme';

export default function BibliographyScreen() {
  const { isDark } = useTheme();

  const references = [
    {
      category: '🧬 Reserva Ovárica y AMH',
      papers: [
        'Anti-Müllerian hormone: physiology and clinical implications. Human Reproduction Update, 2014.',
        'Serum antimüllerian hormone levels: a biomarker of ovarian response. Fertility and Sterility, 2019.',
        'Age-specific serum anti-Müllerian hormone values for 17,120 women. Fertility and Sterility, 2017.',
      ],
    },
    {
      category: '🦋 Función Tiroidea y Fertilidad',
      papers: [
        'Thyroid function and human reproductive health. Endocrine Reviews, 2020.',
        'TSH and fertility: systematic review and meta-analysis. Human Reproduction, 2018.',
        'Subclinical hypothyroidism and pregnancy outcomes. Clinical Endocrinology, 2019.',
      ],
    },
    {
      category: '🍯 Prolactina y Reproducción',
      papers: [
        'Hyperprolactinemia and reproductive disorders. Endocrinology and Metabolism, 2021.',
        'Prolactin levels and ovulatory dysfunction. Journal of Clinical Medicine, 2020.',
        'Management of hyperprolactinemia in reproductive medicine. Fertility and Sterility, 2018.',
      ],
    },
    {
      category: '🍭 Resistencia a la Insulina (HOMA-IR)',
      papers: [
        'Insulin resistance and reproductive disorders. Nature Reviews Endocrinology, 2020.',
        'HOMA-IR and fertility outcomes in PCOS patients. Human Reproduction, 2019.',
        'Metabolic dysfunction and ovarian function. Reproductive Sciences, 2021.',
      ],
    },
    {
      category: '👶 Edad Materna y Fertilidad',
      papers: [
        'Female age-related fertility decline. Committee Opinion No. 589. ACOG, 2014.',
        'Advanced maternal age and adverse pregnancy outcomes. Obstetrics & Gynecology, 2019.',
        'Oocyte aging: cellular and molecular changes. Reproduction, 2020.',
      ],
    },
    {
      category: '⚖️ IMC y Reproducción',
      papers: [
        'Body mass index and fertility: consensus and controversy. Current Opinion, 2018.',
        'Obesity and reproductive function. Human Reproduction Update, 2019.',
        'Weight management and fertility outcomes. Fertility and Sterility, 2020.',
      ],
    },
    {
      category: '🩸 SOP (Síndrome de Ovarios Poliquísticos)',
      papers: [
        'Polycystic ovary syndrome. Lancet, 2020.',
        'PCOS diagnosis and management guidelines. Human Reproduction, 2018.',
        'Metabolic aspects of PCOS. Nature Reviews Endocrinology, 2019.',
      ],
    },
    {
      category: '🔬 Endometriosis',
      papers: [
        'Endometriosis and fertility. Fertility and Sterility, 2019.',
        'Impact of endometriosis on reproductive outcomes. Human Reproduction Update, 2020.',
        'Surgical management of endometriosis-associated infertility. Cochrane Review, 2018.',
      ],
    },
    {
      category: '👨 Factor Masculino',
      papers: [
        'Male infertility: contemporary clinical approaches. Nature Reviews Urology, 2020.',
        'Sperm parameters and fertility outcomes. Human Reproduction, 2019.',
        'Lifestyle factors and male fertility. Andrology, 2021.',
      ],
    },
    {
      category: '🤖 Inteligencia Artificial en Medicina',
      papers: [
        'Artificial intelligence in reproductive medicine. Fertility and Sterility, 2020.',
        'Machine learning applications in fertility prediction. Human Reproduction, 2021.',
        'AI-assisted clinical decision making in reproductive health. Nature Medicine, 2020.',
      ],
    },
  ];

  const guidelines = [
    {
      organization: 'ASRM',
      name: 'American Society for Reproductive Medicine',
      guidelines: [
        'Practice Guidelines for Reproductive Medicine (2021)',
        'Age-related fertility decline: Committee Opinion (2020)',
        'Diagnostic evaluation of the infertile female (2019)',
      ],
    },
    {
      organization: 'ESHRE',
      name: 'European Society of Human Reproduction and Embryology',
      guidelines: [
        'ESHRE Guidelines: management of women with endometriosis (2021)',
        'ESHRE Guidelines: ovarian stimulation for IVF/ICSI (2020)',
        'ESHRE Guidelines: female fertility preservation (2020)',
      ],
    },
    {
      organization: 'WHO',
      name: 'World Health Organization',
      guidelines: [
        'WHO Laboratory Manual for the Examination of Human Semen (2021)',
        'Medical eligibility criteria for contraceptive use (2020)',
        'Guidelines on maternal nutrition (2019)',
      ],
    },
  ];

  return (
    <View style={[styles.container, isDark && styles.containerDark]}>
      {/* Header */}
      <LinearGradient
        colors={[designTheme.colors.primary, designTheme.colors.secondary]}
        style={styles.header}
      >
        <Ionicons name="library" size={32} color="white" />
        <Text style={styles.headerTitle}>Bibliografía Médica</Text>
        <Text style={styles.headerSubtitle}>
          Referencias científicas que sustentan nuestros algoritmos
        </Text>
      </LinearGradient>

      <ScrollView style={styles.content} showsVerticalScrollIndicator={false}>
        {/* Disclaimer */}
        <View style={[styles.disclaimerCard, isDark && styles.disclaimerCardDark]}>
          <Ionicons name="information-circle" size={24} color={designTheme.colors.primary} />
          <Text style={[styles.disclaimerTitle, isDark && styles.textDark]}>
            📖 Acerca de estas Referencias
          </Text>
          <Text style={[styles.disclaimerText, isDark && styles.subtitleDark]}>
            Los algoritmos de esta aplicación se basan en literatura médica peer-reviewed y guías clínicas internacionales. 
            Las referencias aquí listadas representan la evidencia científica que fundamenta nuestros cálculos.
          </Text>
        </View>

        {/* Referencias por Categoría */}
        <Text style={[styles.sectionHeader, isDark && styles.textDark]}>
          📋 Referencias por Área Médica
        </Text>
        
        {references.map((category, index) => (
          <View key={index} style={[styles.categoryCard, isDark && styles.categoryCardDark]}>
            <Text style={[styles.categoryTitle, isDark && styles.textDark]}>
              {category.category}
            </Text>
            {category.papers.map((paper, paperIndex) => (
              <Text key={paperIndex} style={[styles.paperText, isDark && styles.subtitleDark]}>
                • {paper}
              </Text>
            ))}
          </View>
        ))}

        {/* Guías Clínicas */}
        <Text style={[styles.sectionHeader, isDark && styles.textDark, { marginTop: 30 }]}>
          🏛️ Guías Clínicas Internacionales
        </Text>
        
        {guidelines.map((guide, index) => (
          <View key={index} style={[styles.guideCard, isDark && styles.guideCardDark]}>
            <Text style={[styles.guideOrg, isDark && styles.textDark]}>
              {guide.organization} - {guide.name}
            </Text>
            {guide.guidelines.map((guideline, guideIndex) => (
              <Text key={guideIndex} style={[styles.guideText, isDark && styles.subtitleDark]}>
                • {guideline}
              </Text>
            ))}
          </View>
        ))}

        {/* Metodología */}
        <View style={[styles.methodCard, isDark && styles.methodCardDark]}>
          <Text style={[styles.methodTitle, isDark && styles.textDark]}>
            🔬 Metodología de Desarrollo
          </Text>
          <Text style={[styles.methodText, isDark && styles.subtitleDark]}>
            Los algoritmos de esta aplicación fueron desarrollados mediante:

            1. **Revisión sistemática** de literatura médica actual
            2. **Análisis de metadatos** de estudios multicéntricos
            3. **Validación clínica** con casos reales
            4. **Actualización continua** basada en nuevas evidencias
            5. **Revisión por pares** médicos especialistas

            La metodología garantiza que los cálculos reflejen el consenso científico actual en reproducción asistida.
          </Text>
        </View>

        {/* Limitaciones */}
        <View style={[styles.limitCard, isDark && styles.limitCardDark]}>
          <Text style={[styles.limitTitle, isDark && styles.textDark]}>
            ⚠️ Limitaciones de la Evidencia
          </Text>
          <Text style={[styles.limitText, isDark && styles.subtitleDark]}>
            Es importante reconocer que:

            • Los estudios médicos tienen limitaciones inherentes
            • Los resultados pueden variar entre poblaciones
            • La evidencia evoluciona constantemente
            • Los casos individuales pueden diferir de los promedios
            • Algunos factores no están completamente caracterizados

            Por esto, los resultados de la aplicación son estimativos y requieren interpretación médica profesional.
          </Text>
        </View>

        <View style={styles.footer}>
          <Text style={[styles.footerText, isDark && styles.subtitleDark]}>
            Dr Jorge Vasquez R. - Especialista en Reproducción Asistida
          </Text>
          <Text style={[styles.footerText, isDark && styles.subtitleDark, { marginTop: 10 }]}>
            Para consultas sobre metodología: minomoreno86@gmail.com
          </Text>
          <Text style={[styles.footerText, isDark && styles.subtitleDark, { marginTop: 15 }]}>
            Última actualización bibliográfica: Enero 2024
          </Text>
        </View>
      </ScrollView>
    </View>
  );
}

