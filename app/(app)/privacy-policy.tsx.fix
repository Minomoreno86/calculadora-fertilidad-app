import { theme as designTheme } from '@/config/theme';

export default function PrivacyPolicyScreen() {
  const { isDark } = useTheme();

  const sections = [
    {
      title: '📊 Información que Recopilamos',
      content: `Recopilamos únicamente la información médica que tú proporcionas voluntariamente para realizar los cálculos de fertilidad:

• Datos demográficos (edad, IMC)
• Historial ginecológico
• Resultados de laboratorio
• Información del factor masculino

IMPORTANTE: Todos los datos se procesan localmente en tu dispositivo. No enviamos información médica a servidores externos.`
    },
    {
      title: '🔐 Cómo Protegemos tus Datos',
      content: `Tu privacidad médica es nuestra prioridad máxima:

• Procesamiento local: Los cálculos se realizan en tu dispositivo
• Encriptación: Datos almacenados con cifrado AES-256
• Sin servidores: No enviamos datos médicos a la nube
• Anonimización: Si compartiera estadísticas, serían completamente anónimas

Tu información médica NUNCA abandona tu dispositivo sin tu consentimiento explícito.`
    },
    {
      title: '💾 Almacenamiento de Datos',
      content: `• Los datos se guardan localmente en tu dispositivo
• Puedes eliminar toda la información desde Configuración
• Al desinstalar la app, todos los datos se eliminan automáticamente
• No realizamos copias de seguridad automáticas en la nube`
    },
    {
      title: '🤝 Compartir Información',
      content: `NO compartimos, vendemos o alquilamos tu información médica con terceros.

Excepciones únicamente si:
• Lo autorizas explícitamente
• Es requerido por ley
• Es necesario para proteger derechos legales

Tu información médica es confidencial y permanece bajo tu control.`
    },
    {
      title: '📱 Tecnologías de Seguimiento',
      content: `• No usamos cookies de seguimiento
• No implementamos análisis de comportamiento
• No recopilamos datos de ubicación
• No accedemos a otros datos del dispositivo

Solo procesamos los datos médicos que tú proporcionas directamente.`
    },
    {
      title: '👶 Protección de Menores',
      content: `Esta aplicación está clasificada para mayores de 17 años debido a su contenido médico especializado. No recopilamos información de menores de edad de forma intencional.`
    },
    {
      title: '🌍 Transferencias Internacionales',
      content: `Al procesar datos localmente, no realizamos transferencias internacionales de tu información médica personal.`
    },
    {
      title: '⚖️ Tus Derechos',
      content: `Tienes derecho a:
• Acceder a toda tu información
• Rectificar datos incorrectos
• Eliminar toda tu información
• Portabilidad de datos
• Retirar consentimiento en cualquier momento

Para ejercer estos derechos, contacta: privacy@calculadora-fertilidad.com`
    },
            {
          title: '📞 Contacto',
          content: `Para preguntas sobre privacidad:

📧 Email: minomoreno86@gmail.com
🌐 Web: https://www.drjorgeavasquezr.com
📱 App: Configuración > Servicio al Cliente

Tiempo de respuesta: 48 horas máximo.`
