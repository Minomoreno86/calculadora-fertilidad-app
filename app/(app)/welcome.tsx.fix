/**
 * 🎉 PANTALLA DE BIENVENIDA CON LOGIN OPCIONAL
 * 
 * Primera pantalla que ve el usuario - puede elegir login o continuar como invitado
 */

import React from 'react';
import {
  StyleSheet,
  View,
  Text,
  TouchableOpacity,
  Dimensions,
  ImageBackground,
} from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { Ionicons } from '@expo/vector-icons';
import { router } from 'expo-router';
import { useTheme } from '@/contexts/ThemeContext';
import { theme as designTheme } from '@/config/theme';

const { width, height } = Dimensions.get('window');

// ===================================================================
// 🏠 COMPONENTE PRINCIPAL
// ===================================================================

export default function WelcomeScreen() {
  const { isDark } = useTheme();

  // 👤 Ir a Login
  const handleLogin = () => {
    router.push('/login');
  };

  // 🏥 Continuar como invitado (ir directo a calculadora)
  const handleContinueAsGuest = () => {
    router.replace('/index');
  };

  return (
    <View style={[styles.container, isDark && styles.containerDark]}>
      {/* 🎨 Background Gradient */}
      <LinearGradient
        colors={[
          designTheme.colors.primary,
          designTheme.colors.secondary,
          '#4a90e2',
          '#357abd',
        ]}
        style={styles.backgroundGradient}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
      />

      {/* ⭐ Content */}
      <View style={styles.content}>
        {/* 🏥 Logo y Branding */}
        <View style={styles.logoSection}>
          <View style={styles.logoContainer}>
            <LinearGradient
              colors={['rgba(255,255,255,0.3)', 'rgba(255,255,255,0.1)']}
              style={styles.logoBackground}
            >
              <Ionicons name="medical" size={64} color="white" />
            </LinearGradient>
          </View>
          
          <Text style={styles.appTitle}>Calculadora de Fertilidad IA</Text>
          <Text style={styles.appSubtitle}>
            Análisis médico avanzado con inteligencia artificial
          </Text>
          <Text style={styles.appAuthor}>
            Dr Jorge Vasquez R.
          </Text>
        </View>

        {/* 🌟 Características destacadas */}
        <View style={styles.featuresSection}>
          <View style={styles.feature}>
            <Ionicons name="analytics" size={28} color="rgba(255,255,255,0.9)" />
            <Text style={styles.featureText}>Cálculos precisos basados en IA</Text>
          </View>
          
          <View style={styles.feature}>
            <Ionicons name="chatbubbles" size={28} color="rgba(255,255,255,0.9)" />
            <Text style={styles.featureText}>Dr. IA personalizado</Text>
          </View>
          
          <View style={styles.feature}>
            <Ionicons name="trending-up" size={28} color="rgba(255,255,255,0.9)" />
            <Text style={styles.featureText}>Simulador de mejoras</Text>
          </View>
        </View>

        {/* 🎯 Botones de acción */}
        <View style={styles.actionsSection}>
          {/* Login Button */}
          <TouchableOpacity
            style={styles.loginButton}
            onPress={handleLogin}
            activeOpacity={0.8}
          >
            <LinearGradient
              colors={['rgba(255,255,255,0.25)', 'rgba(255,255,255,0.15)']}
              style={styles.loginButtonGradient}
              start={{ x: 0, y: 0 }}
              end={{ x: 1, y: 0 }}
            >
              <Ionicons name="log-in" size={24} color="white" />
              <Text style={styles.loginButtonText}>Iniciar Sesión</Text>
              <Text style={styles.loginButtonSubtext}>Acceso a funciones premium</Text>
            </LinearGradient>
          </TouchableOpacity>

          {/* Continue as Guest */}
          <TouchableOpacity
            style={styles.guestButton}
            onPress={handleContinueAsGuest}
            activeOpacity={0.8}
          >
            <View style={styles.guestButtonContent}>
              <Ionicons name="calculator" size={20} color="rgba(255,255,255,0.8)" />
              <Text style={styles.guestButtonText}>Continuar como invitado</Text>
            </View>
          </TouchableOpacity>
        </View>

        {/* 📜 Legal notice */}
        <View style={styles.legalSection}>
          <Text style={styles.legalText}>
            Al usar esta aplicación, acepta nuestros{'\n'}
            <Text 
              style={styles.legalLink}
              onPress={() => router.push('/(app)/terms-of-service')}
            >
              Términos de Servicio
            </Text>
            {' y '}
            <Text 
              style={styles.legalLink}
              onPress={() => router.push('/(app)/privacy-policy')}
            >
              Política de Privacidad
            </Text>
          </Text>
          
          <Text style={styles.medicalDisclaimer}>
            ⚠️ Esta app no sustituye la consulta médica profesional
          </Text>
        </View>
      </View>

      {/* ⚙️ Config button en esquina */}
      <TouchableOpacity
        style={styles.configButton}
        onPress={() => router.push('/(app)/config')}
        activeOpacity={0.7}
      >
        <Ionicons name="settings-outline" size={24} color="rgba(255,255,255,0.8)" />
      </TouchableOpacity>
    </View>
  );
}

